#day05_1_processing_python_cos_sin_dragon_ball
#國中教cos() sin()有什麼用
#大學3D電腦圖學有用
size(400,400) #視窗大小400*400 正中心200*200
ellipse(200,200,300,300) #圓 正中心(200,200) 圓的大小300*300
for i in range(7): #七個龍珠
    a=(PI*2/7)*i #對應角度a是1/7個圓*i
    ellipse(200+150*cos(a),200+150*sin(a),80,80)
    #畫出80*80的小圓
    #圓心(200,200) 半徑150 x座標對應 cos(a)
    #圓心(200,200) 半徑150 y座標對應 sin(a)
